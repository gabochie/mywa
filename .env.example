# Copy to .env and fill in your own values. NEVER commit the real .env.
# See docker-compose.yml for how each variable is used.

# --- mywa app ---
MYWA_STATE=/data/state

# --- OpenClaw ---
OPENCLAW_IMAGE=openclaw:local-sandbox
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_MSTEAMS_PORT=3978
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=UTC
OPENCLAW_CONFIG_DIR=
OPENCLAW_WORKSPACE_DIR=
OPENCLAW_AUTH_PROFILE_SECRET_DIR=

# --- Hermes ---
HERMES_HOME=
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
API_SERVER_KEY=

# --- Providers (optional, used by the AI agents) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Docker ---
DOCKER_GID=0
